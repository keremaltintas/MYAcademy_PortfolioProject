@model List<MYAcademy_PortfolioProject.Entities.About>

@{
    ViewData["Title"] = "Hakkımda Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Hakkımda Yönetimi</h3>
            <p class="text-muted mb-0">
                Kişisel profil ve hakkımda bilgilerinizi buradan yönetebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="About"
           asp-action="CreateAbout"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Yeni Kayıt Ekle
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ad Soyad</th>
                            <th>Meslek</th>
                            <th>Konum</th>
                            <th>Uzmanlık</th>
                            <th>E-posta</th>
                            <th>İş Durumu</th>
                            <th></th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.AboutId</td>

                                    <td class="fw-semibold">
                                        @item.NameSurname
                                    </td>

                                    <td>@item.JobTitle</td>

                                    <td>@item.Location</td>

                                    <td>
                                        @item.Expert
                                    </td>

                                    <td>@item.Email</td>

                                    <td>
                                        @if (item.OpenToWork)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                İş Arıyor
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                İş Aramıyor
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="education-actions">

                                            <a asp-area="Admin"
                                               asp-controller="About"
                                               asp-action="UpdateAbout"
                                               asp-route-id="@item.AboutId"
                                               class="education-btn education-btn-edit">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Düzenle</span>
                                            </a>

                                            <form asp-area="Admin"
                                                  asp-controller="About"
                                                  asp-action="DeleteAbout"
                                                  asp-route-id="@item.AboutId"
                                                  method="post"
                                                  class="delete-form">

                                                @Html.AntiForgeryToken()

                                                <button type="button"
                                                        class="education-btn education-btn-delete deleteButton">
                                                    <i class="bi bi-trash3"></i>
                                                    <span>Sil</span>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                                    Henüz hakkımda kaydı bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.querySelectorAll(".deleteButton").forEach(button => {
            button.addEventListener("click", function () {

                const form = this.closest(".delete-form");

                Swal.fire({
                    title: "Hakkımda kaydını silmek istiyor musunuz?",
                    text: "Bu işlem geri alınamaz.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#dc3545",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Evet, sil",
                    cancelButtonText: "Vazgeç"
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });

            });
        });
    </script>
}
