@model MYAcademy_PortfolioProject.Entities.Education

@{
    ViewData["Title"] = "Eğitim Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid mt-4">

    <h3 class="mb-4">Eğitim Güncelle</h3>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Education"
                  asp-action="UpdateEducation"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="EducationId" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Eğitim Başlığı</label>
                    <input asp-for="Title" class="form-control"
                           placeholder="Örn: Bilgisayar Mühendisliği" />
                </div>

                <div class="mb-3">
                    <label asp-for="SubTitle" class="form-label">Okul / Üniversite</label>
                    <input asp-for="SubTitle" class="form-control"
                           placeholder="Örn: Ankara Üniversitesi" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Eğitim hakkında açıklama yazınız..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Duration" class="form-label">Eğitim Süresi</label>
                    <input asp-for="Duration" class="form-control"
                           placeholder="Örn: 2020 - 2024" />
                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-area="Admin"
                       asp-controller="Education"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Vazgeç
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Değişiklikleri Kaydet
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>
