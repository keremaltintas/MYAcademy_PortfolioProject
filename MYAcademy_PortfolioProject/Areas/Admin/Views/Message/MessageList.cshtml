@model List<MYAcademy_PortfolioProject.Entities.Message>

@{
    ViewData["Title"] = "Gelen Mesajlar";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var totalMessages = Model.Count;
    var unreadMessages = Model.Count(x => !x.IsRead);
    var readMessages = Model.Count(x => x.IsRead);
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Gelen Mesajlar</h3>
            <p class="text-muted mb-0">
                Ziyaretçilerden gelen mesajları buradan yönetebilirsiniz.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary px-3 py-2">
                <i class="bi bi-envelope me-1"></i>
                @totalMessages Mesaj
            </span>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Toplam Mesaj</p>
                        <h3 class="fw-bold mb-0">@totalMessages</h3>
                    </div>
                    <div class="rounded-3 bg-primary-subtle text-primary p-3">
                        <i class="bi bi-envelope fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Okunmamış Mesaj</p>
                        <h3 class="fw-bold mb-0">@unreadMessages</h3>
                    </div>
                    <div class="rounded-3 bg-warning-subtle text-warning p-3">
                        <i class="bi bi-envelope-exclamation fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Okunmuş Mesaj</p>
                        <h3 class="fw-bold mb-0">@readMessages</h3>
                    </div>
                    <div class="rounded-3 bg-success-subtle text-success p-3">
                        <i class="bi bi-envelope-open fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Message Table -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h5 class="fw-bold mb-1">Mesaj Listesi</h5>
                    <small class="text-muted">
                        Gelen tüm mesajlar
                    </small>
                </div>

                <div class="input-group" style="max-width: 280px;">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           id="messageSearch"
                           class="form-control bg-light border-start-0"
                           placeholder="Mesajlarda ara..." />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0" id="messageTable">

                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">#</th>
                        <th>Gönderici</th>
                        <th>E-posta</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-semibold text-muted">
                                    #@item.MessageId
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                                             style="width:38px;height:38px;min-width:38px;">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <span class="fw-semibold">
                                            @item.NameSurname
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <a href="mailto:@item.Email"
                                       class="text-decoration-none text-secondary">
                                        @item.Email
                                    </a>
                                </td>

                                <td>
                                    <span class="text-dark">
                                        @(string.IsNullOrWhiteSpace(item.Subject) ? "Konu belirtilmemiş" : item.Subject)
                                    </span>
                                </td>

                                <td class="text-muted">
                                    @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    @if (item.IsRead)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Okundu
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis px-3 py-2">
                                            <i class="bi bi-envelope me-1"></i>
                                            Okunmadı
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2">

                                        <a href="/Admin/Message/MessageDetails/@item.MessageId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Mesajı Görüntüle">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Message"
                                              asp-action="DeleteMessage"
                                              method="post"
                                              class="delete-message-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@item.MessageId" />

                                            <button type="button" class="btn btn-sm btn-outline-danger delete-message-btn">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-envelope-open text-muted"
                                   style="font-size:45px;"></i>
                                <h6 class="fw-bold mt-3">Henüz mesaj bulunmuyor</h6>
                                <p class="text-muted mb-0">
                                    Ziyaretçilerden gelen mesajlar burada görüntülenecek.
                                </p>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 p-3">
            <small class="text-muted">
                Toplam @totalMessages mesaj listeleniyor.
            </small>
        </div>

    </div>

</div>

<script>
    document.getElementById("messageSearch").addEventListener("keyup", function () {
        var searchValue = this.value.toLowerCase();
        var rows = document.querySelectorAll("#messageTable tbody tr");

        rows.forEach(function (row) {
            var rowText = row.innerText.toLowerCase();
            row.style.display = rowText.includes(searchValue) ? "" : "none";
        });
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".delete-message-btn").forEach(button => {

            button.addEventListener("click", async function () {

                const form = this.closest(".delete-message-form");

                const result = await Swal.fire({
                    title: "Emin misiniz?",
                    text: "Bu mesaj kalıcı olarak silinecek!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Evet, sil!",
                    cancelButtonText: "Vazgeç"
                });

                if (result.isConfirmed) {
                    HTMLFormElement.prototype.submit.call(form);
                }

            });

        });

    });
</script>
