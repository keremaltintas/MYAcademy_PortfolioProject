@model List<MYAcademy_PortfolioProject.Entities.Skill>

@{
    ViewData["Title"] = "Yetenek Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var categories = ViewBag.Categories as List<MYAcademy_PortfolioProject.Entities.SkillCategory>
                     ?? new List<MYAcademy_PortfolioProject.Entities.SkillCategory>();
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Yetenek Yönetimi</h3>
            <p class="text-muted mb-0">Teknik yetkinliklerini ve uzmanlık alanlarını buradan yönetebilirsin.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Skill"
           asp-action="CreateSkill"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Yeni Yetenek Ekle
        </a>
    </div>

    <!-- STATISTICS -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-code-slash fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 small">Toplam Yetenek</p>
                        <h4 class="fw-bold mb-0">@ViewBag.TotalSkillCount</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 small">Aktif Yetenek</p>
                        <h4 class="fw-bold mb-0">@ViewBag.ActiveSkillCount</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-grid fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 small">Yetenek Kategorisi</p>
                        <h4 class="fw-bold mb-0">@ViewBag.CategoryCount</h4>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- FILTER -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-area="Admin"
                  asp-controller="Skill"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Yetenek Ara</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control border-start-0"
                                   placeholder="Yetenek adı yazın..." />
                        </div>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Kategori</label>
                        <select name="categoryId" class="form-select">
                            <option value="">Tüm Kategoriler</option>

                            @foreach (var category in categories)
                            {
                                if (ViewBag.SelectedCategory != null &&
                                (int)ViewBag.SelectedCategory == category.SkillCategoryId)
                                {
                                    <option value="@category.SkillCategoryId" selected>
                                        @category.CategoryName
                                    </option>
                                }
                                else
                                {
                                    <option value="@category.SkillCategoryId">
                                        @category.CategoryName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-funnel me-1"></i>Filtrele
                        </button>

                        <a asp-area="Admin"
                           asp-controller="Skill"
                           asp-action="Index"
                           class="btn btn-light border"
                           title="Filtreleri Temizle">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- SKILL TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Yetenek Listesi</h5>
                <span class="badge bg-light text-dark">
                    @(Model?.Count ?? 0) kayıt gösteriliyor
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Yetenek</th>
                            <th>Kategori</th>
                            <th style="min-width:180px;">Yetkinlik Seviyesi</th>
                            <th>Deneyim</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-3 p-2"
                                                 style="background-color:@(item.SkillColor ?? "#8276D9")20; color:@(item.SkillColor ?? "#8276D9");">
                                                @if (!string.IsNullOrWhiteSpace(item.SkillIcon) &&
                                                                                        item.SkillIcon.StartsWith("bi "))
                                                {
                                                    <i class="@item.SkillIcon fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-code-slash fs-5"></i>
                                                }
                                            </div>

                                            <div>
                                                <div class="fw-semibold">@item.SkillName</div>
                                                <small class="text-muted">ID: @item.SkillId</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge rounded-pill"
                                              style="background-color:@(item.SkillCategory?.CategoryColor ?? "#8276D9")20;
                                                             color:@(item.SkillCategory?.CategoryColor ?? "#8276D9");">
                                            @item.SkillCategory?.CategoryName
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-between mb-1">
                                            <small class="text-muted">Seviye</small>
                                            <small class="fw-semibold">@item.SkillValue%</small>
                                        </div>

                                        <div class="progress" style="height:7px;">
                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width:@(Math.Clamp(item.SkillValue, 0, 100))%;
                                                                background-color:@(item.SkillColor ?? "#8276D9");"
                                                 aria-valuenow="@item.SkillValue"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.ExperienceYear.HasValue)
                                        {
                                            <span>@item.ExperienceYear yıl</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Belirtilmedi</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark">
                                            @item.DisplayOrder
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                                Pasif
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Skill"
                                               asp-action="UpdateSkill"
                                               asp-route-id="@item.SkillId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Düzenle">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <form asp-area="Admin"
                                                  asp-controller="Skill"
                                                  asp-action="DeleteSkill"
                                                  asp-route-id="@item.SkillId"
                                                  method="post"
                                                  class="delete-form">

                                                @Html.AntiForgeryToken()

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger deleteButton"
                                                        title="Sil">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                    <h6 class="mt-3 fw-semibold">Yetenek bulunamadı</h6>
                                    <p class="text-muted mb-0">
                                        Arama veya kategori filtrelerini değiştirebilirsin.
                                    </p>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".deleteButton").forEach(button => {

                button.addEventListener("click", function () {

                    const form = this.closest(".delete-form");

                    Swal.fire({
                        title: "Yeteneği silmek istiyor musunuz?",
                        text: "Bu işlem geri alınamaz.",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#dc3545",
                        cancelButtonColor: "#6c757d",
                        confirmButtonText: "Evet, sil",
                        cancelButtonText: "Vazgeç"
                    }).then((result) => {

                        if (result.isConfirmed) {
                            form.submit();
                        }

                    });

                });

            });

        });
    </script>
}
