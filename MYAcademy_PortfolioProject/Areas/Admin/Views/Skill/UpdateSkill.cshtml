@model MYAcademy_PortfolioProject.Entities.Skill

@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var categories = ViewBag.Categories as List<MYAcademy_PortfolioProject.Entities.SkillCategory>
                     ?? new List<MYAcademy_PortfolioProject.Entities.SkillCategory>();
}

<div class="container-fluid py-4">


    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Yetenek Güncelle</h3>
            <p class="text-muted mb-0">
                @Model.SkillName adlı yeteneğin bilgilerini düzenleyebilirsin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Skill"
           asp-action="Index"
           class="btn btn-light border">
            <i class="bi bi-arrow-left me-2"></i>Listeye Dön
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3"
                             style="background-color:#EEEAFE; color:#8276D9;">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Yetenek Bilgileri</h5>
                            <small class="text-muted">
                                Yetenek bilgilerini ve kategori ilişkisini güncelle.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="Skill"
                          asp-action="UpdateSkill"
                          method="post"
                          id="updateSkillForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="SkillId" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="row g-4">


                            <div class="col-md-6">
                                <label asp-for="SkillName" class="form-label fw-semibold">
                                    Yetenek Adı
                                </label>

                                <input asp-for="SkillName"
                                       class="form-control"
                                       placeholder="Örn: ASP.NET Core" />

                                <span asp-validation-for="SkillName"
                                      class="text-danger small"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="SkillCategoryId" class="form-label fw-semibold">
                                    Yetenek Kategorisi
                                </label>

                                <select asp-for="SkillCategoryId"
                                        class="form-select"
                                        required>

                                    <option value="">Kategori Seçiniz</option>

                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.SkillCategoryId">
                                            @category.CategoryName
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="SkillCategoryId"
                                      class="text-danger small"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="SkillValue" class="form-label fw-semibold">
                                    Yetkinlik Seviyesi (%)
                                </label>

                                <input asp-for="SkillValue"
                                       type="number"
                                       min="0"
                                       max="100"
                                       class="form-control"
                                       id="skillValue"
                                       placeholder="Örn: 85" />

                                <span asp-validation-for="SkillValue"
                                      class="text-danger small"></span>

                                <div class="progress mt-3" style="height:8px;">
                                    <div id="skillProgress"
                                         class="progress-bar"
                                         role="progressbar"
                                         style="width:@(Math.Clamp(Model.SkillValue, 0, 100))%; background-color:@(Model.SkillColor ?? "#8276D9");">
                                    </div>
                                </div>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="ExperienceYear" class="form-label fw-semibold">
                                    Deneyim Süresi (Yıl)
                                </label>

                                <input asp-for="ExperienceYear"
                                       type="number"
                                       min="0"
                                       class="form-control"
                                       placeholder="Örn: 3" />

                                <span asp-validation-for="ExperienceYear"
                                      class="text-danger small"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="SkillColor" class="form-label fw-semibold">
                                    Yetenek Rengi
                                </label>

                                <div class="input-group">
                                    <input asp-for="SkillColor"
                                           type="color"
                                           class="form-control form-control-color"
                                           id="skillColor"
                                           title="Renk seçiniz" />

                                    <input type="text"
                                           id="skillColorText"
                                           class="form-control"
                                           value="@Model.SkillColor"
                                           placeholder="#8276D9" />
                                </div>

                                <span asp-validation-for="SkillColor"
                                      class="text-danger small"></span>
                            </div>

                
                            <div class="col-md-6">
                                <label asp-for="SkillIcon" class="form-label fw-semibold">
                                    İkon Sınıfı
                                </label>

                                <input asp-for="SkillIcon"
                                       class="form-control"
                                       id="skillIcon"
                                       placeholder="Örn: bi bi-code-slash" />

                                <span asp-validation-for="SkillIcon"
                                      class="text-danger small"></span>

                                <small class="text-muted">
                                    Bootstrap Icons veya Devicon sınıfı kullanabilirsin.
                                </small>
                            </div>

                         
                            <div class="col-md-6">
                                <label asp-for="DisplayOrder" class="form-label fw-semibold">
                                    Görüntülenme Sırası
                                </label>

                                <input asp-for="DisplayOrder"
                                       type="number"
                                       min="0"
                                       class="form-control" />

                                <span asp-validation-for="DisplayOrder"
                                      class="text-danger small"></span>
                            </div>

                           
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Açıklama
                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Bu yetenekle ilgili kısa bir açıklama yazın..."></textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger small"></span>
                            </div>

                            
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive"
                                           class="form-check-input"
                                           type="checkbox"
                                           role="switch" />

                                    <label asp-for="IsActive" class="form-check-label fw-semibold">
                                        Yetenek Aktif
                                    </label>
                                </div>

                                <small class="text-muted">
                                    Pasif yapılan yetenekler portföyde gösterilmez.
                                </small>
                            </div>

                        </div>

                        <hr class="my-4" />

                        
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-area="Admin"
                               asp-controller="Skill"
                               asp-action="Index"
                               class="btn btn-light border px-4">
                                Vazgeç
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-2"></i>
                                Değişiklikleri Kaydet
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("updateSkillForm");
            const skillValue = document.getElementById("skillValue");
            const skillProgress = document.getElementById("skillProgress");
            const skillColor = document.getElementById("skillColor");
            const skillColorText = document.getElementById("skillColorText");

           
            skillValue.addEventListener("input", function () {
                let value = Math.min(100, Math.max(0, Number(this.value) || 0));
                skillProgress.style.width = value + "%";
            });

        
            skillColor.addEventListener("input", function () {
                skillColorText.value = this.value;
                skillProgress.style.backgroundColor = this.value;
            });

        
            skillColorText.addEventListener("input", function () {
                if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) {
                    skillColor.value = this.value;
                    skillProgress.style.backgroundColor = this.value;
                }
            });

    
            form.addEventListener("submit", function (e) {

                if (form.dataset.confirmed === "true") {
                    return;
                }

                e.preventDefault();

                Swal.fire({
                    title: "Değişiklikleri kaydetmek istiyor musunuz?",
                    text: "Yetenek bilgileri güncellenecektir.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonColor: "#8276D9",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Evet, güncelle",
                    cancelButtonText: "Vazgeç"
                }).then((result) => {

                    if (result.isConfirmed) {
                        form.dataset.confirmed = "true";
                        form.requestSubmit();
                    }

                });

            });

        });
    </script>
}
