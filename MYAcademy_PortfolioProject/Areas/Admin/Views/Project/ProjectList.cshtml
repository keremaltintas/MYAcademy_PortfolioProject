@model List<MYAcademy_PortfolioProject.Entities.Project>

@{
    ViewData["Title"] = "Proje Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var categories = ViewBag.Categories as List<MYAcademy_PortfolioProject.Entities.Category>
                     ?? new List<MYAcademy_PortfolioProject.Entities.Category>();
}

<div class="container-fluid py-4">


    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Proje Yönetimi</h3>
            <p class="text-muted mb-0">
                Portföyünde sergilediğin projeleri buradan yönetebilirsin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Project"
           asp-action="CreateProject"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Yeni Proje Ekle
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-kanban fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 small">Toplam Proje</p>
                        <h4 class="fw-bold mb-0">@ViewBag.TotalProjectCount</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 small">Proje Kategorisi</p>
                        <h4 class="fw-bold mb-0">@ViewBag.CategoryCount</h4>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Project"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Proje Ara</label>

                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control border-start-0"
                                   placeholder="Proje başlığı yazın..." />
                        </div>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Kategori</label>

                        <select name="categoryId" class="form-select">
                            <option value="">Tüm Kategoriler</option>

                            @foreach (var category in categories)
                            {
                                if (ViewBag.SelectedCategory != null &&
                                (int)ViewBag.SelectedCategory == category.CategoryId)
                                {
                                    <option value="@category.CategoryId" selected>
                                        @category.CategoryName
                                    </option>
                                }
                                else
                                {
                                    <option value="@category.CategoryId">
                                        @category.CategoryName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-funnel me-1"></i>Filtrele
                        </button>

                        <a asp-area="Admin"
                           asp-controller="Project"
                           asp-action="Index"
                           class="btn btn-light border"
                           title="Filtreleri Temizle">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Proje Listesi</h5>

                <span class="badge bg-light text-dark">
                    @(Model?.Count ?? 0) kayıt gösteriliyor
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Proje</th>
                            <th>Kategori</th>
                            <th>Açıklama</th>
                            <th>GitHub</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                             
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">

                                            @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                                            {
                                                <img src="@item.CoverImageUrl"
                                                     alt="@item.Title"
                                                     style="width:65px;height:50px;object-fit:cover;border-radius:9px;" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center rounded-3 bg-light"
                                                     style="width:65px;height:50px;">
                                                    <i class="bi bi-image text-muted fs-4"></i>
                                                </div>
                                            }

                                        <div>
                                            <div class="fw-semibold">@item.Title</div>
                                            <small class="text-muted">ID: @item.ProjectId</small>
                                        </div>

                                    </div>
                                </td>

                                
                                <td>
                                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary">
                                        @(item.Category?.CategoryName ?? "Kategori belirtilmedi")
                                    </span>
                                </td>

                               
                                <td style="max-width:280px;">
                                    <span class="text-muted">
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                                                            ? "Açıklama bulunmuyor."
                                                                            : item.Description.Length > 90
                                                                            ? item.Description.Substring(0, 90) + "..."
                                                                            : item.Description)
                                </span>
                            </td>

                                  
                                    <td>
                                @if (!string.IsNullOrWhiteSpace(item.GithubUrl))
                                        {
                                            <a href="@item.GithubUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-dark">
                                                <i class="bi bi-github me-1"></i>GitHub
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Bağlantı yok</span>
                                        }
                                    </td>

                                   
                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Project"
                                               asp-action="UpdateProject"
                                               asp-route-id="@item.ProjectId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Düzenle">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <form asp-area="Admin"
                                                  asp-controller="Project"
                                                  asp-action="DeleteProject"
                                                  asp-route-id="@item.ProjectId"
                                                  method="post"
                                                  class="delete-form">

                                                @Html.AntiForgeryToken()

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger deleteButton"
                                                        title="Sil">
                                                    <i class="bi bi-trash3"></i>
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-folder2-open fs-1 text-muted"></i>
                                    <h6 class="mt-3 fw-semibold">Henüz proje bulunmuyor</h6>
                                    <p class="text-muted mb-0">
                                        Yeni proje ekleyerek portföyünü oluşturmaya başlayabilirsin.
                                    </p>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".deleteButton").forEach(button => {

                button.addEventListener("click", function () {

                    const form = this.closest(".delete-form");

                    Swal.fire({
                        title: "Projeyi silmek istiyor musunuz?",
                        text: "Bu işlem geri alınamaz.",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#dc3545",
                        cancelButtonColor: "#6c757d",
                        confirmButtonText: "Evet, sil",
                        cancelButtonText: "Vazgeç"
                    }).then((result) => {

                        if (result.isConfirmed) {
                            form.submit();
                        }

                    });

                });

            });

        });
    </script>
}
